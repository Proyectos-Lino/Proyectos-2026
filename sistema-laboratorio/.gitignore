/*
!/.gitignore
!/README.md
!/backend/
!/frontend/

/backend/*
!/backend/.gitignore
!/backend/.env.example
!/backend/.mvn/
!/backend/mvnw
!/backend/mvnw.cmd
!/backend/pom.xml
!/backend/Dockerfile
!/backend/.dockerignore
!/backend/src/

/frontend/*
!/frontend/.gitignore
!/frontend/.env.example
!/frontend/.prettierignore
!/frontend/.prettierrc.json
!/frontend/package.json
!/frontend/package-lock.json
!/frontend/index.html
!/frontend/eslint.config.js
!/frontend/tsconfig*.json
!/frontend/vite.config.ts
!/frontend/vercel.json
!/frontend/Dockerfile
!/frontend/.dockerignore
!/frontend/nginx.conf
!/frontend/src/
!/frontend/public/
!/frontend/desktop/
!/frontend/scripts/
/frontend/scripts/*
!/frontend/scripts/build-desktop.mjs

**/.git/
**/node_modules/
**/target/
**/dist/
**/release/
**/.idea/
**/.vscode/
**/*.iml
**/*.log
**/*.tsbuildinfo
**/.env
**/.env.*
!backend/.env.example
!frontend/.env.example
