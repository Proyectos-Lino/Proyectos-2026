# ─────────────────────────────────────────────────────────────────────────
# Variables de entorno del sistema (Docker Compose / Dokploy).
# Copia este archivo como ".env" en esta misma carpeta y completa los valores.
# El archivo .env NO se sube a git.
#
# Para correr el backend sin Docker, las mismas claves pueden ir en
# Backend/src/main/resources/application-local.properties (tampoco se sube).
# ─────────────────────────────────────────────────────────────────────────

# Base de datos
DB_PASSWORD=postgres

# Imágenes: "local" (en el servidor, funciona sin internet) o "cloudinary"
IMAGENES_ALMACENAMIENTO=local

# Cloudinary (solo si IMAGENES_ALMACENAMIENTO=cloudinary y para ver imágenes antiguas)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Gemini (opción "Con IA" al importar preguntas)
GEMINI_API_KEY=

# Frontend
VITE_API_BASE_URL=/api/v1
